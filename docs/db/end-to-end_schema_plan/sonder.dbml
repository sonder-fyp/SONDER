  content_version_id uuid [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'evaluation_recent_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS evaluation_recent_idx ON evaluation_study (created_at DESC)']
  }

  checks {
    `window_end > window_start`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Offline study/dataset hash/protocol window/caveat and pinned engine/content references.'
}

Table sonder.evaluation_arm [headercolor: #EAB308] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  study_id uuid [not null]
  code text [not null]
  definition text [not null]

  indexes {
    (study_id, code) [unique]
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Named method/baseline definition within a study; multiple baselines are rows.'
}

Table sonder.metric_definition [headercolor: #EAB308] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code text [not null]
  revision integer [not null]
  label text [not null]
  definition text [not null]
  denominator_definition text [not null]
  unit text [not null]
  good_when text [not null]

  indexes {
    (code, revision) [unique]
  }

  checks {
    `revision > 0`
    `good_when IN ('up', 'down', 'neutral')`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Immutable mathematically defined metric revision with unit, denominator and desired direction.'
}

Table sonder.evaluation_result [headercolor: #EAB308] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  arm_id uuid [not null]
  metric_id uuid [not null]
  subject_id uuid [null]
  stratum text [not null, default: `'all'`]
  value numeric [not null]
  sample_size integer [not null]
  numerator numeric [null]
  denominator numeric [null]
  lower_bound numeric [null]
  upper_bound numeric [null]
  caveat text [not null]

  indexes {
    (arm_id, metric_id, subject_id, stratum) [unique, note: 'PostgreSQL UNIQUE NULLS NOT DISTINCT: NULL values compare equal for this uniqueness constraint. DBML unique alone does not encode that behavior.']
  }

  checks {
    `sample_size > 0`
    `denominator > 0`
    `lower_bound IS NULL OR upper_bound IS NULL OR lower_bound <= upper_bound`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Aggregate arm/metric/subject/stratum measurement, sample count, optional numerator/denominator/interval and caveat.'
}

Table sonder.evaluation_comparison [headercolor: #EAB308] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  result_id uuid [not null]
  baseline_result_id uuid [not null]
  comparison_note text [not null]

  indexes {
    (result_id, baseline_result_id) [unique]
  }

  checks {
    `result_id <> baseline_result_id`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Comparison to another comparable result, not copied baseline label/value/delta.'
}

Table sonder.job_run [headercolor: #EAB308] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  kind text [not null]
  request_key text [not null, unique]
  status text [not null, default: `'queued'`]
  started_at timestamptz [null]
  ended_at timestamptz [null]
  heartbeat_at timestamptz [null]
  error_text text [null]

  indexes {
    (status, heartbeat_at) [name: 'job_health_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS job_health_idx ON job_run (status, heartbeat_at)']
  }

  checks {
    `kind IN ('calibration', 'gap_scan', 'generation', 'evaluation', 'indexing')`
    `status IN ('queued', 'running', 'succeeded', 'failed', 'cancelled')`
    `ended_at IS NULL OR (started_at IS NOT NULL AND ended_at >= started_at)`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Idempotent batch job lifecycle, heartbeat/time/error for calibration, gap scanning, generation, evaluation or indexing.'
}

Table sonder.item_embedding [headercolor: #64748B] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  item_id uuid [not null]
  model_id uuid [not null]
  text_hash text [not null]
  indexed_at timestamptz [not null, default: `now()`]
  embedding vector [not null, note: 'Actual SQL type: vector(EMBEDDING_DIMENSION). The model and dimension are not yet chosen; all vector columns share the dimension selected for tier 5.']

  indexes {
    (item_id, model_id) [unique]
    (model_id, item_id) [name: 'item_embedding_model_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS item_embedding_model_idx ON item_embedding (model_id, item_id)']
    embedding [name: 'item_embedding_hnsw', note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS item_embedding_hnsw ON item_embedding USING hnsw (embedding vector_cosine_ops)']
  }

  checks {
    `text_hash ~ '^[0-9a-f]{64}$'`
    `vector_norm(embedding) > 0`
  }

  Note: 'Tier 5; source: 05_vectors.sql. Immutable approved frozen item text vector keyed by source and exact model, with SHA-256 text hash. Late tier: requires pgvector and the selected EMBEDDING_DIMENSION; diagram inclusion does not imply deployment.'
}

Table sonder.concept_chunk_embedding [headercolor: #64748B] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
