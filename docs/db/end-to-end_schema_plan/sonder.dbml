  summary_id uuid [not null, unique]
  teacher_id uuid [not null]
  approved_at timestamptz [not null, default: `now()`]
  note text [not null]

  Note: 'Tier 2; source: 02_learning.sql. Separate teacher wording approval; approved diagnosis alone does not approve an LLM rewrite.'
}

