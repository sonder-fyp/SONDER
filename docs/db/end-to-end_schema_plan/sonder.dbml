  Note: 'Tier 2; source: 02_learning.sql. Explicit cancellation event for an unfinished appointment, retaining reason/time.'
}

Table sonder.parent_summary [headercolor: #22C55E] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  review_id uuid [not null]
  revision integer [not null]
  what_we_found text [not null]
  what_to_work_on text [not null]
  hows_it_going text [not null]
  origin text [not null]
  similarity_score numeric [null]
  similarity_floor numeric [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (review_id, revision) [unique]
  }

  checks {
    `revision > 0`
    `origin IN ('structured', 'generated')`
    `similarity_score BETWEEN -1 AND 1`
    `similarity_floor BETWEEN -1 AND 1`
    `origin <> 'generated' OR (similarity_score IS NOT NULL AND similarity_floor IS NOT NULL AND similarity_score >= similarity_floor)`
  }

  Note: 'Tier 2; source: 02_learning.sql. Immutable plain-language wording revision of one accepted review; similarity-tested generated or structured fallback. The derived approved_parent_summary view joins approvals to the latest accepted teacher review; it has no separate stored rows or declared foreign keys. Guardian authorization is applied by the service.'
}

