  }

  Note: 'Tier 2; source: 02_learning.sql. One answer/result observation per presentation; engine computes resolved/persistent/uncertain outside SQL.'
}

Table sonder.verification_cancellation [headercolor: #22C55E] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  check_id uuid [not null, unique]
