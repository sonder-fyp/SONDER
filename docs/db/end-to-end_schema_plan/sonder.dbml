  }

  checks {
    `num_nonnulls(item_id, distractor_item_id, note_id, recommendation_id, suggestion_id, run_id, summary_id, doc_id, message_id) = 1`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Exactly one typed per-revision artefact provenance record; purpose/note without polymorphic FK or copied state.'
}

Table sonder.provenance_call [headercolor: #D946EF] {
