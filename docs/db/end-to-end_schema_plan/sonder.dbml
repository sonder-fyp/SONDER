Table sonder.remediation_delivery [headercolor: #22C55E] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  review_id uuid [not null, unique]
  intervention_id uuid [not null]
  study_note_id uuid [null]
  status text [not null, default: `'delivered'`]
  delivered_at timestamptz [not null, default: `now()`]
  read_at timestamptz [null]
  completed_at timestamptz [null]

  indexes {
    delivered_at [name: 'delivery_history_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS delivery_history_idx ON remediation_delivery (delivered_at DESC)']
  }

  checks {
    `status IN ('delivered', 'read', 'completed', 'superseded')`
    `read_at IS NULL OR read_at >= delivered_at`
    `completed_at IS NULL OR (read_at IS NOT NULL AND completed_at >= read_at)`
    `status NOT IN ('read', 'completed') OR read_at IS NOT NULL`
    `status <> 'completed' OR completed_at IS NOT NULL`
  }

  Note: 'Tier 2; source: 02_learning.sql. One review-specific intervention/note delivery and actual read/completion/supersession lifecycle.'
}

