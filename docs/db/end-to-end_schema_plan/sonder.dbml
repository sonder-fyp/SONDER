  indexes {
    (gap_id, misconception_revision_id) [unique]
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Exactly one thin-coverage or two separator misconception revisions; count deferred to transaction end.'
}

Table sonder.generation_run [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  gap_id uuid [not null]
  drafter_model_id uuid [not null]
  scorer_model_id uuid [not null]
  pass_mark numeric [not null]
  target_min integer [not null]
  target_max integer [not null]
  max_rounds integer [not null]
  request_key text [not null, unique]
  started_at timestamptz [not null, default: `now()`]
  status text [not null, default: `'queued'`]

  indexes {
    (gap_id, started_at) [name: 'generation_gap_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS generation_gap_idx ON generation_run (gap_id, started_at DESC)']
  }

  checks {
    `pass_mark BETWEEN 0 AND 1`
    `target_min > 0`
    `max_rounds > 0`
    `status IN ('queued', 'running', 'paused', 'ready', 'exhausted', 'failed', 'published')`
    `target_max >= target_min`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Gap-specific bounded drafter/scorer execution with fixed models, target interval, pass mark and round budget.'
}

Table sonder.generation_round [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  run_id uuid [not null]
  round_index integer [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (run_id, round_index) [unique]
  }

  checks {
    `round_index > 0`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Ordered immutable iteration of one run; candidate counts derive from structured candidates/call logs.'
}

Table sonder.generated_item [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  round_id uuid [not null]
  candidate_index integer [not null]
  item_id uuid [not null, unique]
  drafter_call_id uuid [not null]
  distractor_source text [not null]
  mapping_source text [not null, default: `'ai'`]
  status text [not null, default: `'drafted'`]
  rejection_reason text [null]
  published_item_id uuid [null, unique]

  indexes {
    (round_id, candidate_index) [unique]
    (status, round_id) [name: 'candidate_queue_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS candidate_queue_idx ON generated_item (status, round_id)']
  }

  checks {
    `candidate_index > 0`
    `distractor_source IN ('computed', 'ai')`
    `mapping_source IN ('ai', 'engine_verified')`
    `status IN ('drafted', 'kept', 'rejected', 'approved', 'published')`
    `status <> 'rejected' OR rejection_reason IS NOT NULL`
    `(status = 'published') = (published_item_id IS NOT NULL)`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Pipeline candidate pointing to normalized draft item, verification origin, lifecycle and publication lineage.'
}

Table sonder.quality_rubric [headercolor: #F97316] {
