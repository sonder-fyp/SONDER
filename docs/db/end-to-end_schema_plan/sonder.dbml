    embedding [name: 'chunk_embedding_hnsw', note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS chunk_embedding_hnsw ON concept_chunk_embedding USING hnsw (embedding vector_cosine_ops)']
  }

  checks {
    `text_hash ~ '^[0-9a-f]{64}$'`
    `vector_norm(embedding) > 0`
  }

  Note: 'Tier 5; source: 05_vectors.sql. Immutable approved Tutor chunk vector keyed by source and exact model, with SHA-256 text hash. Late tier: requires pgvector and the selected EMBEDDING_DIMENSION; diagram inclusion does not imply deployment.'
}

// Every declared SQL foreign key, preserving deletion and update actions.
// Junction tables above preserve the physical many-to-many relationships.

Ref: sonder.app_user.id - sonder.password_credential.user_id [delete: cascade, update: no action]
Ref: sonder.auth_session.user_id > sonder.app_user.id [delete: cascade, update: no action]
Ref: sonder.auth_token.user_id > sonder.app_user.id [delete: cascade, update: no action]
Ref: sonder.guardian_link.parent_id > sonder.app_user.id [delete: restrict, update: no action]
Ref: sonder.guardian_link.student_id > sonder.app_user.id [delete: restrict, update: no action]
Ref: sonder.class_teacher.class_id > sonder.classroom.id [delete: restrict, update: no action]
Ref: sonder.class_teacher.teacher_id > sonder.app_user.id [delete: restrict, update: no action]
Ref: sonder.enrolment.class_id > sonder.classroom.id [delete: restrict, update: no action]
Ref: sonder.enrolment.student_id > sonder.app_user.id [delete: restrict, update: no action]
Ref: sonder.enrolment.id - sonder.student_home_class.enrolment_id [delete: restrict, update: no action]
Ref: sonder.class_subject.class_id > sonder.classroom.id [delete: restrict, update: no action]
