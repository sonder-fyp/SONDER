Table sonder.reviewer_mapping_proposal [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  review_id uuid [not null]
  option_id uuid [not null]
  misconception_revision_id uuid [null]
  rationale text [not null]

  indexes {
    (review_id, option_id, misconception_revision_id) [unique, note: 'PostgreSQL UNIQUE NULLS NOT DISTINCT: NULL values compare equal for this uniqueness constraint. DBML unique alone does not encode that behavior.']
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Reviewer-specific option mapping proposal, including explicit unmapped proposal; not an edit of live mapping.'
}

Table sonder.review_adjudication [headercolor: #F97316] {
