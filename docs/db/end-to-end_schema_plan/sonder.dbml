  rubric_code text [not null, unique]
  definition text [not null]

  Note: 'Tier 4; source: 04_ai_trust.sql. Immutable identified quality definition; model replacement does not silently replace rubric meaning.'
}

Table sonder.rubric_dimension [headercolor: #F97316] {
