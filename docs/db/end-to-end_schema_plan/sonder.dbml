  indexes {
    (generated_item_id, reviewer_id) [unique]
    (reviewer_id, assigned_at) [name: 'reviewer_queue_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS reviewer_queue_idx ON content_review_assignment (reviewer_id, assigned_at)']
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. One named reviewer assigned to one immutable candidate; independently assigned reviewers have distinct accounts.'
}

Table sonder.generation_review [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  assignment_id uuid [not null, unique]
  verdict text [not null]
