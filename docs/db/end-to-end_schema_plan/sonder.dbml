  created_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, created_at) [name: 'assistant_owner_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS assistant_owner_idx ON assistant_thread (owner_id, created_at DESC)']
  }

  checks {
    `kind IN ('tutor', 'consultant')`
    `(kind = 'tutor' AND misconception_revision_id IS NOT NULL AND num_nonnulls(enrolment_id, class_id, escalation_id) = 0) OR (kind = 'consultant' AND misconception_revision_id IS NULL AND num_nonnulls(enrolment_id, class_id, escalation_id) = 1)`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Owner\'s bounded Tutor concept or Consultant enrolment/class/escalation context; separate from human DMs.'
}

Table sonder.assistant_message [headercolor: #EC4899] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  thread_id uuid [not null]
  sequence integer [not null]
  speaker text [not null]
  body text [not null]
  preset_key text [null]
  call_id uuid [null, unique]
  outcome text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (thread_id, sequence) [unique]
  }

  checks {
    `sequence >= 0`
    `speaker IN ('user', 'assistant')`
    `outcome IN ('user_input', 'answered', 'abstained', 'fallback')`
    `(speaker = 'user' AND outcome = 'user_input' AND call_id IS NULL) OR (speaker = 'assistant' AND outcome <> 'user_input')`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Immutable ordered user/assistant turn, preset, logged call and fixed answered/abstained/fallback outcome.'
}

Table sonder.assistant_message_evidence [headercolor: #EC4899] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  message_id uuid [not null]
  evidence_id uuid [not null]
  position integer [not null]
  display_text text [not null]

  indexes {
    (message_id, position) [unique]
    (message_id, evidence_id) [unique]
  }

  checks {
    `position > 0`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Ordered displayed evidence/citations for a turn, concept-checked for Tutor replies.'
}

Table sonder.consultant_suggestion [headercolor: #EC4899] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  call_id uuid [not null]
  enrolment_id uuid [null]
  escalation_id uuid [null]
  message_id uuid [null, unique]
  claim text [not null]
  confidence numeric [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (escalation_id, created_at) [name: 'suggestion_escalation_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS suggestion_escalation_idx ON consultant_suggestion (escalation_id, created_at DESC)']
    (enrolment_id, created_at) [name: 'suggestion_pace_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS suggestion_pace_idx ON consultant_suggestion (enrolment_id, created_at DESC)']
  }

  checks {
    `confidence BETWEEN 0 AND 1`
    `num_nonnulls(enrolment_id, escalation_id) = 1`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Non-authoritative individual claim/confidence from a call about an enrolment or escalation.'
}

Table sonder.suggestion_evidence [headercolor: #EC4899] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  suggestion_id uuid [not null]
  evidence_id uuid [not null]
  position integer [not null]
  display_text text [not null]

  indexes {
    (suggestion_id, position) [unique]
    (suggestion_id, evidence_id) [unique]
  }

  checks {
    `position > 0`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Ordered relational evidence list supporting one Consultant claim; at least one required at commit.'
}

Table sonder.suggestion_review [headercolor: #EC4899] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  suggestion_id uuid [not null]
  revision integer [not null]
  teacher_id uuid [not null]
  verdict text [not null]
  note text [not null]
  reviewed_at timestamptz [not null, default: `now()`]

  indexes {
    (suggestion_id, revision) [unique]
  }

  checks {
    `revision > 0`
    `verdict IN ('approved', 'rejected')`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Ordered teacher approval/rejection of a pace/escalation suggestion; student release uses latest approved event.'
}

Table sonder.coverage_gap [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  topic_revision_id uuid [not null]
  kind text [not null]
  target_minimum integer [not null]
  note text [not null]
  detected_from_session_id uuid [null]
  detected_at timestamptz [not null, default: `now()`]
  bank_count_at_detection integer [not null]
  status text [not null, default: `'open'`]
  scan_key text [not null, unique]

  indexes {
    (status, detected_at) [name: 'gap_queue_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS gap_queue_idx ON coverage_gap (status, detected_at)']
  }

  checks {
    `kind IN ('separator', 'thin_coverage')`
    `target_minimum > 0`
    `bank_count_at_detection >= 0`
    `status IN ('open', 'generating', 'in_review', 'closed')`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Version/topic-scoped observed separator/thin-coverage gap, note/minimum/bank snapshot and queue lifecycle.'
}

Table sonder.gap_misconception [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  gap_id uuid [not null]
