    (teacher_id, created_at) [name: 'dm_inbox_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS dm_inbox_idx ON dm_thread (teacher_id, created_at DESC)']
    guardian_link_id [name: 'dm_guardian_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS dm_guardian_idx ON dm_thread (guardian_link_id) WHERE guardian_link_id IS NOT NULL']
  }

  Note: 'Tier 3; source: 03_messaging.sql. Private 1:1 teacher/enrolment context; optional guardian link identifies a distinct parent counterpart.'
}

