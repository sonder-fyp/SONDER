  }

  checks {
    `overall BETWEEN 0 AND 1`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Immutable model/rubric result for a candidate; overall is a distinct model output, not a copied dimension sum.'
}

Table sonder.quality_dimension_score [headercolor: #F97316] {
