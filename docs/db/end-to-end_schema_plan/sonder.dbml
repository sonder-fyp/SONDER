  }

  Note: 'Tier 4; source: 04_ai_trust.sql. Distinct validation/surfacing audit event; reviewer identity is a FK, not a name list.'
}

Table sonder.evaluation_study [headercolor: #EAB308] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
