// Sonder: paste this entire file into the DBML editor at https://dbdiagram.io/
// Derived from docs/db/01_core.sql through 05_vectors.sql. The SQL is authoritative.
// Diagram only: do not use exported DBML SQL to replace the deployment scripts.
// Syntax reference: https://dbml.dbdiagram.io/docs/
// Table groups: https://dbml.dbdiagram.io/syntax/enrichment-visualization/#tablegroup
// Coverage: 103 tables, 619 columns, 103 primary keys, 122 unique keys, 194 foreign keys, 140 checks, 36 secondary indexes.
// Group names carry tiers T1-T5; all tables live in the SAME sonder schema/database.
// One-to-one refs put the parent first and the unique foreign-key column second.
// Nullable columns retain optional FK participation; no synthetic many-to-many shortcuts.
// PostgreSQL-specific index predicates/order/HNSW and NULLS NOT DISTINCT appear in notes.
// Triggers, functions, privileges, transaction rules and application authorization remain in SQL/plan.
// approved_parent_summary is a derived VIEW, not a base table or an additional FK relationship.
// Embedding dimensions are undecided: vector columns are labelled vector with a dimension note.
// Source SHA-256 (for detecting later SQL changes):
// 01_core.sql: 9a7347ed04a79bd8fc05e109cdb8219272e62f3217e1918de09080f6163b3218
// 02_learning.sql: ab4f59d281994101cc9cf6fe4cf5fca0f4aaac1d000b1b0fa6b2898da3cb6743
// 03_messaging.sql: 1f95c972a42cad40d6e8e06ee0843fdff6130979473a9fa5635763683e7fb824
// 04_ai_trust.sql: eedea0848b41634578730e7b0d4bb30df12299e8cee38a8b404a43a0172de15f
// 05_vectors.sql: 57111fc8fbd2b21decdc6e80a0a16113559775a9ab1e0116a96884bb641ea860

Project Sonder {
  database_type: 'PostgreSQL'
  Note: 'Complete physical-table diagram for PostgreSQL 16 and pgvector. T1 core, T2 learning, T3 messaging, T4 AI/trust/evaluation, T5 vectors. SQL files remain authoritative for triggers, frozen/append-only content, state transitions, exact option counts, authorization, NULLS NOT DISTINCT and physical index details. The approved_parent_summary view is described on parent_summary. EMBEDDING_DIMENSION and the embedding model remain undecided.'
}

Table sonder.app_user [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null, unique]
  role text [not null]
  display_name text [not null]
  locale text [not null, default: `'en'`]
  time_zone text [not null, default: `'Asia/Karachi'`]
  status text [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `email = lower(btrim(email))`
    `role IN ('student', 'teacher', 'parent', 'admin')`
    `status IN ('active', 'deactivated', 'withdrawn')`
  }

  Note: 'Tier 1; source: 01_core.sql. Role-bearing account and locale/time zone; active/deactivated/withdrawn identity, never a student class-name cache.'
}

Table sonder.password_credential [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  password_hash text [not null]
  changed_at timestamptz [not null, default: `now()`]

  Note: 'Tier 1; source: 01_core.sql. One locally managed password hash per account, independently revocable from product evidence.'
}

Table sonder.auth_session [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz [null]

  indexes {
    (user_id, expires_at) [name: 'auth_session_user_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS auth_session_user_idx ON auth_session (user_id, expires_at)']
  }

  checks {
    `expires_at > created_at`
    `revoked_at IS NULL OR revoked_at >= created_at`
  }

  Note: 'Tier 1; source: 01_core.sql. Expiring hashed bearer-session token with optional irrevocable revocation time.'
}

Table sonder.auth_token [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  kind text [not null]
  token_hash text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz [null]

  indexes {
    (user_id, expires_at) [name: 'auth_token_user_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS auth_token_user_idx ON auth_token (user_id, expires_at)']
  }

  checks {
    `kind IN ('reset_password', 'verify_email')`
    `expires_at > created_at`
    `consumed_at IS NULL OR consumed_at >= created_at`
  }

  Note: 'Tier 1; source: 01_core.sql. Single-use, expiring password-reset/email-verification token; kind separates token purpose.'
}

Table sonder.guardian_link [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  parent_id uuid [not null]
  student_id uuid [not null]
  status text [not null, default: `'active'`]
  linked_at timestamptz [not null, default: `now()`]

  indexes {
    (parent_id, student_id) [unique]
    student_id [name: 'guardian_student_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS guardian_student_idx ON guardian_link (student_id) WHERE status = \'active\'']
  }

  checks {
    `status IN ('active', 'revoked')`
    `parent_id <> student_id`
  }

  Note: 'Tier 1; source: 01_core.sql. A particular parent-child authorization relationship; multiple parents and children are independent links.'
}

Table sonder.classroom [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  note text [not null, default: `''`]
  join_code text [not null, unique]
  grade_level smallint [not null, default: `8`]
  time_zone text [not null, default: `'Asia/Karachi'`]
  status text [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `join_code = upper(btrim(join_code)) AND length(join_code) >= 8`
    `grade_level BETWEEN 1 AND 12`
    `status IN ('active', 'archived')`
  }

  Note: 'Tier 1; source: 01_core.sql. Class metadata, globally unique normalized join code, grade and archival lifecycle.'
}

Table sonder.class_teacher [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  class_id uuid [not null]
  teacher_id uuid [not null]
  status text [not null, default: `'active'`]
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (class_id, teacher_id) [unique]
    (teacher_id, class_id) [name: 'teacher_classes_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS teacher_classes_idx ON class_teacher (teacher_id, class_id) WHERE status = \'active\'']
  }

  checks {
    `status IN ('active', 'departed')`
  }

  Note: 'Tier 1; source: 01_core.sql. Teacher assignment to a class; co-teaching and departure preserve historical attribution.'
}

Table sonder.enrolment [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  class_id uuid [not null]
  student_id uuid [not null]
  status text [not null, default: `'active'`]
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (class_id, student_id) [unique]
    (student_id, class_id) [name: 'student_classes_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS student_classes_idx ON enrolment (student_id, class_id)']
  }

  checks {
    `status IN ('active', 'left')`
  }

  Note: 'Tier 1; source: 01_core.sql. One student-class relationship; first joined time and current membership lifecycle depend on the pair.'
}

Table sonder.student_home_class [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  enrolment_id uuid [not null, unique]

  Note: 'Tier 1; source: 01_core.sql. Optional default enrolment; joined student uniqueness is serialized by membership_guard.'
}

Table sonder.subject [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null, unique]

  Note: 'Tier 1; source: 01_core.sql. Subject identity; shared by all content and class focus relations, without subject-specific engine tables.'
}

Table sonder.class_subject [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  class_id uuid [not null]
  subject_id uuid [not null]

  indexes {
    (class_id, subject_id) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Subjects a class offers; no singular teacher/subject focus copied onto the class row.'
}

Table sonder.content_version [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  subject_id uuid [not null]
  version_code text [not null]
  note text [not null, default: `''`]
  created_at timestamptz [not null, default: `now()`]
  status text [not null, default: `'draft'`]

  indexes {
    (subject_id, version_code) [unique]
  }

  checks {
    `status IN ('draft', 'frozen')`
  }

  Note: 'Tier 1; source: 01_core.sql. Per-subject pack identifier and frozen lifecycle; freeze instant comes from audit_event.'
}

Table sonder.topic [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  subject_id uuid [not null]
  external_id text [not null]

  indexes {
    (subject_id, external_id) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Immutable subject-scoped external topic identity, not a mutable curriculum label.'
}

Table sonder.topic_revision [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  topic_id uuid [not null]
  content_version_id uuid [not null]
  name text [not null]
  blurb text [not null, default: `''`]
  grade8_in_scope boolean [not null, default: `TRUE`]

  indexes {
    (content_version_id, topic_id) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Version-specific topic wording, blurb and Grade-8 scope for historical interpretation.'
}

Table sonder.misconception [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  subject_id uuid [not null]
  code text [not null]
  external_id text [not null]

  indexes {
    (subject_id, code) [unique]
    (subject_id, external_id) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Immutable subject-scoped local code and external identifier; M1 can occur in each subject.'
}

Table sonder.misconception_revision [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  misconception_id uuid [not null]
  content_version_id uuid [not null]
  name text [not null]
  description text [not null]
  cognitive_origin text [not null, default: `''`]
  status text [not null, default: `'pending'`]
  engine_tier smallint [not null]

  indexes {
    (content_version_id, misconception_id) [unique]
    (content_version_id, status) [name: 'misconception_catalogue_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS misconception_catalogue_idx ON misconception_revision (content_version_id, status)']
  }

  checks {
    `status IN ('pending', 'validated', 'catalogued_only', 'retired')`
    `engine_tier IN (1, 2)`
    `engine_tier <> 1 OR status = 'validated'`
  }

  Note: 'Tier 1; source: 01_core.sql. Frozen-pack description, cognitive origin, review state and engine/catalogue tier.'
}

Table sonder.topic_misconception [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  topic_revision_id uuid [not null]
  misconception_revision_id uuid [not null]
  target_minimum integer [not null, default: `3`]
  old_topic_label text [null]
  review_note text [not null, default: `''`]
  disposition text [not null, default: `'keep'`]

  indexes {
    (topic_revision_id, misconception_revision_id) [unique]
  }

  checks {
    `target_minimum > 0`
    `disposition IN ('keep', 'move', 'remove')`
  }

  Note: 'Tier 1; source: 01_core.sql. Version-specific curriculum association, coverage minimum, old label and keep/move/remove review note.'
}

Table sonder.source_reference [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  citation_key text [not null, unique]
  citation text [not null]
  url text [null]
  licence text [not null]
  scope_note text [not null, default: `''`]

  Note: 'Tier 1; source: 01_core.sql. Immutable cited source/licence scope, reused without repeating bibliographic facts.'
}

Table sonder.misconception_source [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  misconception_revision_id uuid [not null]
  source_id uuid [not null]
  locator text [not null, default: `''`]

  indexes {
    (misconception_revision_id, source_id, locator) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Source locator supporting one misconception revision; independent from topic membership.'
}

Table sonder.item [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  topic_revision_id uuid [not null]
  target_misconception_revision_id uuid [not null]
  external_id text [not null]
  stem text [not null]
  batch text [null]
  difficulty_est numeric [null]
  origin text [not null]
  review_status text [not null, default: `'draft'`]

  indexes {
    (topic_revision_id, external_id) [unique]
    (topic_revision_id, review_status) [name: 'item_topic_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS item_topic_idx ON item (topic_revision_id, review_status)']
    (target_misconception_revision_id, review_status) [name: 'item_target_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS item_target_idx ON item (target_misconception_revision_id, review_status)']
  }

  checks {
    `difficulty_est BETWEEN 0 AND 1`
    `origin IN ('authored', 'generated')`
    `review_status IN ('draft', 'in_review', 'approved', 'rejected')`
  }

  Note: 'Tier 1; source: 01_core.sql. One version-specific structured question stem, topic and target misconception, external ID, batch/difficulty and human review state.'
}

Table sonder.item_option [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  item_id uuid [not null]
  label text [not null]
  external_id text [null]
  option_text text [not null]
  is_correct boolean [not null]

  indexes {
    (item_id, label) [unique]
    (item_id, external_id) [unique]
  }

  checks {
    `label IN ('A', 'B', 'C', 'D')`
  }

  Note: 'Tier 1; source: 01_core.sql. One of four labeled answer options; unique label per item, correct flag and optional external option ID.'
}

Table sonder.option_misconception [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  option_id uuid [not null]
  misconception_revision_id uuid [not null]
  rationale text [not null]

  indexes {
    (option_id, misconception_revision_id) [unique]
    (misconception_revision_id, option_id) [name: 'option_mapping_reverse_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS option_mapping_reverse_idx ON option_misconception (misconception_revision_id, option_id)']
  }

  Note: 'Tier 1; source: 01_core.sql. Wrong-option attribution with pair-specific rationale; zero-to-two links, none for correct option.'
}

Table sonder.item_numeric_parameter [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  item_id uuid [not null]
  name text [not null]
  value numeric [not null]
  unit text [null]

  indexes {
    (item_id, name) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Named scalar numeric parameter/unit for a question, avoiding queried numeric JSON.'
}

Table sonder.item_source [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  item_id uuid [not null]
  source_id uuid [not null]
  locator text [not null, default: `''`]

  indexes {
    (item_id, source_id, locator) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Source citation locator for an item; licensing relation is independent of its misconception mappings.'
}

Table sonder.item_approval [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  item_id uuid [not null, unique]
  reviewer_id uuid [not null]
  approved_at timestamptz [not null, default: `now()`]
  note text [not null]

  checks {
    `length(btrim(note)) > 0`
  }

  Note: 'Tier 1; source: 01_core.sql. A separate authenticated human approval event for an authored or final publication item; the generated source\'s two votes remain generation_review rows.'
}

Table sonder.hypothesis [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  content_version_id uuid [not null]
  kind text [not null]
  misconception_revision_id uuid [null]

  indexes {
    (content_version_id, kind, misconception_revision_id) [unique, note: 'PostgreSQL UNIQUE NULLS NOT DISTINCT: NULL values compare equal for this uniqueness constraint. DBML unique alone does not encode that behavior.']
  }

  checks {
    `kind IN ('misconception', 'none', 'unmodelled')`
    `(kind = 'misconception') = (misconception_revision_id IS NOT NULL)`
  }

  Note: 'Tier 1; source: 01_core.sql. Pack-specific misconception/NONE/UNMODELLED identity; special states are not catalogue misconceptions.'
}

Table sonder.item_prediction [headercolor: #06B6D4] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  hypothesis_id uuid [not null]
  option_id uuid [not null]
  rationale text [not null]

  indexes {
    (option_id, hypothesis_id) [unique]
  }

  Note: 'Tier 1; source: 01_core.sql. Hypothesis-predicted option, including correct-by-coincidence predictions; item is derived from option.'
}

Table sonder.engine_release [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  release_code text [not null, unique]
  code_hash text [not null]
  confidence_threshold numeric [not null]
  minimum_answers integer [not null]
  tie_epsilon numeric [not null]
  eig_floor numeric [not null]
  unmodelled_threshold numeric [not null]
  selection_policy text [not null]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `confidence_threshold > 0 AND confidence_threshold <= 1`
    `minimum_answers > 0`
    `tie_epsilon BETWEEN 0 AND 1`
    `eig_floor >= 0`
    `unmodelled_threshold BETWEEN 0 AND 1`
  }

  Note: 'Tier 1; source: 01_core.sql. Immutable deterministic implementation/hash, thresholds, answer minimum and selection policy.'
}

Table sonder.response_model [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  content_version_id uuid [not null]
  model_code text [not null]
  source text [not null]
  calibration_note text [not null]
  created_at timestamptz [not null, default: `now()`]
  status text [not null, default: `'draft'`]

  indexes {
    (content_version_id, model_code) [unique]
  }

  checks {
    `source IN ('prior', 'calibrated')`
    `status IN ('draft', 'frozen')`
  }

  Note: 'Tier 1; source: 01_core.sql. Versioned categorical response-likelihood model for one content pack; freeze independent of content freeze.'
}

Table sonder.response_parameter [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  response_model_id uuid [not null]
  hypothesis_id uuid [not null]
  slip numeric [not null]
  guess numeric [not null]

  indexes {
    (response_model_id, hypothesis_id) [unique]
  }

  checks {
    `slip BETWEEN 0 AND 1`
    `guess BETWEEN 0 AND 1`
  }

  Note: 'Tier 1; source: 01_core.sql. Hypothesis-specific slip/guess inputs to a particular calibrated/prior model; no mutable global default dependency.'
}

Table sonder.response_probability [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  response_model_id uuid [not null]
  hypothesis_id uuid [not null]
  option_id uuid [not null]
  probability numeric [not null]

  indexes {
    (response_model_id, hypothesis_id, option_id) [unique]
  }

  checks {
    `probability BETWEEN 0 AND 1`
  }

  Note: 'Tier 1; source: 01_core.sql. Joint model-hypothesis-option categorical probability; option gives item, full distributions checked at freeze.'
}

Table sonder.diagnostic_session [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  enrolment_id uuid [not null]
  response_model_id uuid [not null]
  engine_release_id uuid [not null]
  topic_revision_id uuid [null]
  question_budget integer [not null]
  request_key text [not null]
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz [null]
  status text [not null, default: `'in_progress'`]

  indexes {
    (enrolment_id, request_key) [unique]
    (enrolment_id, started_at) [name: 'session_roster_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS session_roster_idx ON diagnostic_session (enrolment_id, started_at DESC)']
    (status, started_at) [name: 'session_queue_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS session_queue_idx ON diagnostic_session (status, started_at) WHERE status <> \'in_progress\'']
  }

  checks {
    `question_budget > 0`
    `status IN ('in_progress', 'diagnosed', 'none_detected', 'escalated_no_separator', 'escalated_exhausted', 'escalated_unmodelled', 'abandoned')`
    `(status = 'in_progress') = (ended_at IS NULL)`
    `ended_at IS NULL OR ended_at >= started_at`
  }

  Note: 'Tier 1; source: 01_core.sql. Run under one enrolment, frozen response model and engine release, optional topic, budget and terminal status.'
}

Table sonder.session_hypothesis [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  hypothesis_id uuid [not null]
  prior_probability numeric [not null]

  indexes {
    (session_id, hypothesis_id) [unique]
  }

  checks {
    `prior_probability BETWEEN 0 AND 1`
  }

  Note: 'Tier 1; source: 01_core.sql. Run-specific prior support and prior probability; candidate support is fixed before any presentation.'
}

Table sonder.session_question [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  step_index integer [not null]
  item_id uuid [not null]
  presented_at timestamptz [not null, default: `now()`]
  selection_reason text [not null]
  entropy_before numeric [not null]
  expected_ig numeric [not null]

  indexes {
    (session_id, step_index) [unique]
    (session_id, item_id) [unique]
  }

  checks {
    `step_index >= 0`
    `entropy_before >= 0`
    `expected_ig >= 0`
  }

  Note: 'Tier 1; source: 01_core.sql. Immutable selected/presented item with index, EIG, prior entropy and reason; pending-question recovery.'
}

Table sonder.session_step [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  step_index integer [not null]
  session_question_id uuid [not null, unique]
  answer_option_id uuid [not null]
  answered_at timestamptz [not null, default: `now()`]
  request_key text [not null]
  calculation_ms numeric [not null]

  indexes {
    (session_id, step_index) [unique]
    (session_id, request_key) [unique]
  }

  checks {
    `step_index >= 0`
    `calculation_ms >= 0`
  }

  Note: 'Tier 1; source: 01_core.sql. Immutable answer event with timing/request key; copied presentation scope is checked and both determinants are candidate keys.'
}

Table sonder.step_posterior [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  step_id uuid [not null]
  session_hypothesis_id uuid [not null]
  probability numeric [not null]

  indexes {
    (step_id, session_hypothesis_id) [unique]
  }

  checks {
    `probability BETWEEN 0 AND 1`
  }

  Note: 'Tier 1; source: 01_core.sql. One calculated posterior value per answered step and run hypothesis; complete distribution audit.'
}

Table sonder.diagnosis [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null, unique]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Tier 1; source: 01_core.sql. Original engine diagnosis event per session, not a mutable teacher conclusion.'
}

Table sonder.diagnosis_candidate [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  diagnosis_id uuid [not null]
  session_hypothesis_id uuid [not null]
  rank smallint [not null]

  indexes {
    (diagnosis_id, rank) [unique]
    (diagnosis_id, session_hypothesis_id) [unique]
  }

  checks {
    `rank IN (1, 2)`
  }

  Note: 'Tier 1; source: 01_core.sql. One/two ranked engine candidates; confidence is joined from the final posterior, not duplicated.'
}

Table sonder.escalation [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null, unique]
  reason text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Tier 1; source: 01_core.sql. Original engine refusal/reason event; open/resolved is derived from current review.'
}

Table sonder.escalation_candidate [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  escalation_id uuid [not null]
  session_hypothesis_id uuid [not null]
  rank smallint [not null]

  indexes {
    (escalation_id, rank) [unique]
    (escalation_id, session_hypothesis_id) [unique]
  }

  checks {
    `rank IN (1, 2)`
  }

  Note: 'Tier 1; source: 01_core.sql. Zero/two ranked tied candidates linked to actual run hypothesis identities, not JSON labels.'
}

Table sonder.teacher_review [headercolor: #8B5CF6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  revision integer [not null]
  teacher_id uuid [not null]
  decision text [not null]
  conclusion text [null]
  misconception_revision_id uuid [null]
  note text [not null]
  request_key text [not null]
  decided_at timestamptz [not null, default: `now()`]

  indexes {
    (session_id, revision) [unique]
    (session_id, request_key) [unique]
  }

  checks {
    `revision > 0`
    `decision IN ('approved', 'corrected', 'rejected', 'resolved')`
    `conclusion IN ('misconception', 'none_detected')`
    `length(btrim(note)) > 0`
    `(decision = 'rejected' AND conclusion IS NULL AND misconception_revision_id IS NULL) OR (decision <> 'rejected' AND conclusion IS NOT NULL AND (conclusion = 'misconception') = (misconception_revision_id IS NOT NULL))`
  }

  Note: 'Tier 1; source: 01_core.sql. Immutable ordered teacher decision, accepted conclusion and reason; corrections are new revisions.'
}

Table sonder.audit_event [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  actor_id uuid [null]
  event_type text [not null]
  relation_name text [not null]
  row_id uuid [not null]
  request_key text [null]
  occurred_at timestamptz [not null, default: `now()`]
  detail jsonb [not null, default: `CAST('{}' AS jsonb)`]

  indexes {
    (occurred_at, event_type) [name: 'audit_time_idx', type: btree, note: 'Authoritative SQL: CREATE INDEX IF NOT EXISTS audit_time_idx ON audit_event (occurred_at, event_type)']
  }

  Note: 'Tier 1; source: 01_core.sql. Append-only event attribution and opaque optional redacted explanation, with explicit scalar event/time/row reference.'
}

Table sonder.privacy_request [headercolor: #3B82F6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  kind text [not null]
  status text [not null, default: `'requested'`]
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz [null]
  note text [not null, default: `''`]

  indexes {
