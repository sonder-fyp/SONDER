  checks {
    `verdict IN ('approve', 'approve_with_edit', 'reject')`
  }

  Note: 'Tier 4; source: 04_ai_trust.sql. One authenticated verdict/reason event per assignment; editing requires a new draft/publication copy.'
}

Table sonder.review_dispute [headercolor: #F97316] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  generated_item_id uuid [not null]
  option_id uuid [null]
  issue_key text [not null]
  issue text [not null]

  indexes {
